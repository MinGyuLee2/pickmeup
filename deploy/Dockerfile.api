FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY api/package.json api/package.json
COPY web/package.json web/package.json
RUN npm ci --ignore-scripts
COPY api/ api/
RUN npm run build --workspace api && find api/dist -name '*.test.js' -delete && npm prune --omit=dev --ignore-scripts

FROM node:22-bookworm-slim
ENV NODE_ENV=production HOST=0.0.0.0 PORT=4310
WORKDIR /app
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/api/package.json ./api/package.json
COPY --from=build --chown=node:node /app/api/dist ./api/dist
COPY --from=build --chown=node:node /app/api/migrations ./api/migrations
COPY --chown=node:node deploy/run.mjs ./run.mjs
COPY --chown=node:node deploy/runtime-env.mjs ./runtime-env.mjs
USER node
EXPOSE 4310
CMD ["node", "run.mjs", "api"]
