HOST=127.0.0.1
PORT=4310
DATABASE_URL=postgresql://pickmeup:YOUR_LOCAL_PASSWORD@127.0.0.1:55432/pickmeup
NODE_ENV=development
PUBLIC_ORIGIN=http://localhost:5173
# Generate once: node -e 'console.log(require("node:crypto").randomBytes(32).toString("base64"))'
# Keep this stable: it encrypts pending message contents and pairing credentials.
APP_SECRET=REPLACE_WITH_BASE64_32_BYTE_KEY
# local: explicit simulated OTP; no real phone verification or text delivery.
# Omit/disable until a real provider is configured outside local development.
SMS_MODE=local
# For a real provider, set SMS_MODE=sens and fill server-only credentials.
# Starting the worker in sens mode sends real, chargeable messages.
SENS_SERVICE_ID=
SENS_ACCESS_KEY=
SENS_SECRET_KEY=
SENS_FROM=
# Personal-account alternative. Fill these on the server, then use SMS_MODE=solapi.
# Keep SMS_MODE=local until keys, the registered sender and HTTPS are ready.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_FROM=
# Optional Web Push. Keep one stable VAPID key pair; private key stays server-only.
# The separate push worker never dispatches SMS jobs. HTTPS is required in browsers.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
# Optional planned road route, server-only existing Kakao REST key (not the JavaScript map key).
KAKAO_ROUTE_REST_KEY=
