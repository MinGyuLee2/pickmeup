# Only application source, runtime assets and development configuration are published.
/*
!/.gitignore
!/.gitattributes
!/.dockerignore
!/.env.example
!/.nvmrc
!/README.md
!/package.json
!/package-lock.json
!/android/
!/android/**
!/api/
!/api/**
!/web/
!/web/**
!/deploy/
!/deploy/**
!/scripts/
!/scripts/**

# Local configuration, credentials and generated artifacts.
**/node_modules/
**/.gradle/
**/.kotlin/
**/.idea/
**/.vscode/
**/.cxx/
**/__pycache__/
**/build/
**/dist/
**/local.properties
**/.env
**/.env.*
**/.npmrc
**/.DS_Store
*.log
*.apk
*.aab
*.aar
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
*.db
*.sqlite
*.sqlite3
*.dump
*.zip
*.tar
*.gz

# Safe examples and the Gradle wrapper remain versioned.
!/.env.example
!/web/.env.example
!/deploy/deploy.env.example
!/deploy/aws/deploy.env.example
!/android/gradle/wrapper/gradle-wrapper.jar

# Submission packaging and local records stay on this computer.
/scripts/source-bundle.py
/docs/
/design/
/tools/
/output/
/SESSION_HANDOFF.txt
/IMPLEMENTATION_PLAN.md
/.local/

# The contest requires this exact signed release APK under apk/.
!/apk/
/apk/*
!/apk/README.md
!/apk/SHA256SUMS
!/apk/이민규_픽미업_release.apk
